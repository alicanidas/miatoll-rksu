diff --git a/arch/arm64/configs/vendor/atoll-perf_defconfig b/arch/arm64/configs/vendor/atoll-perf_defconfig
index 89438fcbf..408faeb47 100644
--- a/arch/arm64/configs/vendor/atoll-perf_defconfig
+++ b/arch/arm64/configs/vendor/atoll-perf_defconfig
@@ -750,3 +750,23 @@ CONFIG_CRYPTO_AES_ARM64_CE_CCM=y
 CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
 CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
 CONFIG_STACK_HASH_ORDER_SHIFT=12
+
+# SDM720G (joyeuse) CPU topology: 6x LITTLE (cpu0-5) + 2x big (cpu6-7)
+# (base defconfig leaves these empty -> non-interactive build aborts; set explicitly)
+CONFIG_LITTLE_CPU_MASK=63
+CONFIG_BIG_CPU_MASK=192
+
+# RKSU + SUSFS v2.3.0 + NoMount v2.0.0 (miatoll-joyeuse MIUI14, INLINE mode)
+CONFIG_KSU=y
+CONFIG_KSU_SUSFS=y
+CONFIG_KSU_SUSFS_SUS_PATH=y
+CONFIG_KSU_SUSFS_SUS_MOUNT=y
+CONFIG_KSU_SUSFS_SUS_KSTAT=y
+CONFIG_KSU_SUSFS_SPOOF_UNAME=y
+CONFIG_KSU_SUSFS_ENABLE_LOG=y
+CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
+CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
+CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
+CONFIG_KSU_SUSFS_SUS_MAP=y
+CONFIG_NOMOUNT=y
+CONFIG_QCA_CLD_WLAN=m
